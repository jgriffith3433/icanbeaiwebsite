{
  "name": "icanbeai-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered immersive 3D world: create an avatar, enter a Gaussian-splat environment, explore in third person.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,yellow \"npm:dev\" \"npm:dev:server\"",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/index.js",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:generate": "tsx scripts/generate-sample-splat.ts"
  },
  "dependencies": {
    "@adobe/spz": "^0.2.2",
    "@babylonjs/core": "9.30.0",
    "@babylonjs/loaders": "9.30.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.7",
    "fflate": "^0.8.3",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
